import java.io.*;
import java.net.*;
import java.util.*;

public class CentralServer {

    // ========================= GLOBALS =========================

    static Map<Integer, ClientHandler> clientIDs =
            Collections.synchronizedMap(new HashMap<>());

    static List<FittingRoomHandler> fittingRooms =
            Collections.synchronizedList(new ArrayList<>());

    static Queue<ClientHandler> recoveryQueue =
            new LinkedList<>();

    static Queue<ClientHandler> waitingClients =
            new LinkedList<>();

    static Queue<ClientHandler> fittingRoomClients =
            new LinkedList<>();

    // ========================= MAIN =========================

    public static void main(String[] args) {

        System.out.println("Central Server Starting...");

        // CLIENT SERVER THREAD
        new Thread(() -> startClientServer()).start();

        // FITTING ROOM SERVER THREAD
        new Thread(() -> startFittingRoomServer()).start();

        // RECOVERY THREAD
        new Thread(() -> recoveryManager()).start();
    }

    // ========================= CLIENT SERVER =========================

    public static void startClientServer() {

        try (ServerSocket server = new ServerSocket(50000)) {

            System.out.println(
                    "Listening for Clients on port 50000");

            while (true) {

                Socket clientSocket = server.accept();

                System.out.println(
                        "Client Connected: "
                                + clientSocket.getInetAddress());

                ClientHandler client =
                        new ClientHandler(clientSocket);

                Thread t = new Thread(client);

                t.start();
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // ========================= FITTING ROOM SERVER =========================

    public static void startFittingRoomServer() {

        try (ServerSocket fitServer =
                     new ServerSocket(50001)) {

            System.out.println(
                    "Listening for Fitting Rooms on 50001");

            while (true) {

                Socket fittingSocket = fitServer.accept();

                FittingRoomHandler fitting =
                        new FittingRoomHandler(fittingSocket);

                synchronized (fittingRooms) {
                    fittingRooms.add(fitting);
                }

                System.out.println(
                        "Fitting Room Connected: "
                                + fitting.getFittingRoomIP());

                new Thread(fitting).start();
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // ========================= RECOVERY MANAGER =========================

    public static void recoveryManager() {

        while (true) {

            ClientHandler client = null;

            synchronized (recoveryQueue) {

                if (!recoveryQueue.isEmpty()) {
                    client = recoveryQueue.poll();
                }
            }

            if (client != null) {

                try {

                    System.out.println(
                            "Recovering Client "
                                    + client.clientID);

                    client.requestNewRoom();

                } catch (Exception e) {
                    e.printStackTrace();
                }
            }

            try {
                Thread.sleep(100);
            } catch (Exception e) {
            }
        }
    }

    // ========================= CLIENT HANDLER =========================

    public static class ClientHandler implements Runnable {

        // ========================= STATES =========================

        public enum ClientState {
            IDLE,
            ACTIVE_ROOM,
            WAITING,
            RECOVERING_ACTIVE,
            RECOVERING_WAITING,
            DISCONNECTED
        }

        private ClientState state =
                ClientState.IDLE;

        // ========================= VARIABLES =========================

        Socket client;

        BufferedReader clientIn;
        PrintWriter clientOut;

        int clientID = -1;

        FittingRoomHandler assignedRoom;

        // ========================= CONSTRUCTOR =========================

        public ClientHandler(Socket client) {

            this.client = client;

            try {

                clientIn = new BufferedReader(
                        new InputStreamReader(
                                client.getInputStream()));

                clientOut = new PrintWriter(
                        client.getOutputStream(),
                        true);

            } catch (Exception e) {
                e.printStackTrace();
            }
        }

        // ========================= ASSIGN ROOM =========================

        public synchronized void assignRoom(
                FittingRoomHandler room) {

            if (state ==
                    ClientState.DISCONNECTED) {

                return;
            }

            assignedRoom = room;

            state = ClientState.ACTIVE_ROOM;

            waitingClients.remove(this);

            if (!fittingRoomClients.contains(this)) {

                fittingRoomClients.add(this);
            }

            if (!room.assignedClients.contains(this)) {

                room.assignedClients.add(this);
            }

            clientOut.println(
                    "Room Allocated "
                            + clientID
                            + ":"
                            + room.getFittingRoomIP());

            System.out.println(
                    "Assigned Client "
                            + clientID
                            + " to "
                            + room.getFittingRoomIP());
        }

        // ========================= REQUEST ROOM =========================

        public synchronized void requestNewRoom() {

            try {

                synchronized (fittingRooms) {

                    for (FittingRoomHandler room :
                            fittingRooms) {

                        if (!room.active) {
                            continue;
                        }

                        String response;

                        // PRIORITY CLIENTS
                        if (state ==
                                ClientState.RECOVERING_ACTIVE) {

                            response =
                                    room.sendRequest(
                                            "RECOVER_ACTIVE "
                                                    + clientID);

                        } else if (state ==
                                ClientState.RECOVERING_WAITING) {

                            response =
                                    room.sendRequest(
                                            "RECOVER_WAITING "
                                                    + clientID);

                        } else {

                            response =
                                    room.sendRequest(
                                            "ALLOCATE "
                                                    + clientID);
                        }

                        if (response == null) {
                            continue;
                        }

                        System.out.println(
                                "Fitting Room Response: "
                                        + response);

                        // ========================= ALLOCATED

                        if (response.startsWith(
                                "Allocated")) {

                            assignRoom(room);
                            return;
                        }

                        // ========================= WAIT

                        else if (response.startsWith(
                                "Wait")) {

                            assignedRoom = room;

                            state =
                                    ClientState.WAITING;

                            if (!room.assignedClients
                                    .contains(this)) {

                                room.assignedClients
                                        .add(this);
                            }

                            clientOut.println(
                                    "Wait:"
                                            + room
                                            .getFittingRoomIP());

                            return;
                        }
                    }
                }

                clientOut.println("Full");

            } catch (Exception e) {
                e.printStackTrace();
            }
        }

        // ========================= RUN =========================

        @Override
        public void run() {

            try {

                String request;

                while ((request =
                        clientIn.readLine()) != null) {

                    System.out.println(
                            "Client says: "
                                    + request);

                    // ========================= REQUEST ROOM

                    if (request.startsWith(
                            "Request Room")) {

                        String[] parts =
                                request.split(" ");

                        clientID =
                                Integer.parseInt(
                                        parts[2]);

                        clientIDs.put(
                                clientID,
                                this);

                        requestNewRoom();
                    }

                    // ========================= RELEASE ROOM

                    else if (request.startsWith(
                            "Release Room")) {

                        synchronized (
                                CentralServer.class) {

                            if (state !=
                                    ClientState.ACTIVE_ROOM) {

                                clientOut.println(
                                        "No rooms to release");

                                continue;
                            }

                            try {

                                String response =
                                        assignedRoom
                                                .sendRequest(
                                                        "RELEASE "
                                                                + clientID);

                                assignedRoom
                                        .assignedClients
                                        .remove(this);

                                fittingRoomClients
                                        .remove(this);

                                state =
                                        ClientState.IDLE;

                                clientOut.println(
                                        "Room released");

                                // ================= PROMOTE NEXT

                                if (response != null &&
                                        response.startsWith(
                                                "Promoted")) {

                                    String[] parts =
                                            response.split(" ");

                                    int nextClientID =
                                            Integer.parseInt(
                                                    parts[1]);

                                    ClientHandler nextClient =
                                            clientIDs.get(
                                                    nextClientID);

                                    if (nextClient != null &&
                                            nextClient.state !=
                                                    ClientState.DISCONNECTED) {

                                        nextClient.assignRoom(
                                                assignedRoom);
                                    }
                                }

                            } catch (Exception e) {

                                state =
                                        ClientState.IDLE;

                                assignedRoom = null;
                            }
                        }
                    }

                    // ========================= EXIT

                    else if (request.equalsIgnoreCase(
                            "Exit")) {

                        disconnectClient();
                        return;
                    }

                    // ========================= INVALID

                    else {

                        clientOut.println(
                                "Invalid Request");
                    }
                }

            } catch (Exception e) {

                System.out.println(
                        "Client disconnected.");

            } finally {

                disconnectClient();
            }
        }

        // ========================= DISCONNECT =========================

        public synchronized void disconnectClient() {

            try {

                state = ClientState.DISCONNECTED;

                clientIDs.remove(clientID);

                waitingClients.remove(this);

                fittingRoomClients.remove(this);

                if (assignedRoom != null) {

                    assignedRoom.assignedClients
                            .remove(this);
                }

                if (clientIn != null)
                    clientIn.close();

                if (clientOut != null)
                    clientOut.close();

                if (client != null &&
                        !client.isClosed()) {

                    client.close();
                }

                System.out.println(
                        "Client "
                                + clientID
                                + " disconnected.");

            } catch (Exception e) {
                e.printStackTrace();
            }
        }
    }

    // ========================= FITTING ROOM HANDLER =========================

    public static class FittingRoomHandler
            implements Runnable {

        Socket fitting;

        BufferedReader fitIn;
        PrintWriter fitOut;

        boolean active = true;
        boolean recovering = false;

        List<ClientHandler> assignedClients =
                Collections.synchronizedList(
                        new ArrayList<>());

        // ========================= CONSTRUCTOR =========================

        public FittingRoomHandler(Socket fitting) {

            this.fitting = fitting;

            try {

                fitIn = new BufferedReader(
                        new InputStreamReader(
                                fitting.getInputStream()));

                fitOut = new PrintWriter(
                        fitting.getOutputStream(),
                        true);

            } catch (Exception e) {
                e.printStackTrace();
            }
        }

        // ========================= GET IP =========================

        public String getFittingRoomIP() {

            return fitting
                    .getInetAddress()
                    .getHostAddress();
        }

        // ========================= RUN =========================

        @Override
        public void run() {

            System.out.println(
                    "Fitting Room Handler Started");
        }

        // ========================= SEND REQUEST =========================

        public synchronized String sendRequest(
                String msg)
                throws IOException {

            try {

                fitOut.println(msg);

                String response =
                        fitIn.readLine();

                if (response == null) {

                    handleCrash();

                    throw new IOException(
                            "Fitting Room Crashed");
                }

                return response;

            } catch (IOException e) {

                handleCrash();

                throw e;
            }
        }

        // ========================= HANDLE CRASH =========================

        public synchronized void handleCrash() {

            if (recovering) {
                return;
            }

            recovering = true;

            active = false;

            System.out.println(
                    "FITTING ROOM CRASHED: "
                            + getFittingRoomIP());

            synchronized (fittingRooms) {

                fittingRooms.remove(this);
            }

            recoverClients();
        }

        // ========================= RECOVER CLIENTS =========================

        public synchronized void recoverClients() {

            ArrayList<ClientHandler> temp =
                    new ArrayList<>(assignedClients);

            assignedClients.clear();

            for (ClientHandler client : temp) {

                try {

                    if (client.state ==
                            ClientHandler.ClientState
                                    .ACTIVE_ROOM) {

                        client.state =
                                ClientHandler.ClientState
                                        .RECOVERING_ACTIVE;
                    }

                    else if (client.state ==
                            ClientHandler.ClientState
                                    .WAITING) {

                        client.state =
                                ClientHandler.ClientState
                                        .RECOVERING_WAITING;
                    }

                    else {
                        continue;
                    }

                    client.assignedRoom = null;

                    client.clientOut.println(
                            "Fitting Room Server Down");

                    synchronized (recoveryQueue) {

                        if (!recoveryQueue
                                .contains(client)) {

                            recoveryQueue.add(client);
                        }
                    }

                } catch (Exception e) {
                    e.printStackTrace();
                }
            }

            recovering = false;
        }
    }
}
