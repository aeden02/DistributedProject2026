import java.io.*;
import java.net.*;
import java.util.*;

public class CentralServer {

    static Map<Integer, ClientHandler> clientIDs =
            Collections.synchronizedMap(new HashMap<>());

    static List<FittingRoomHandler> fittingRooms =
            Collections.synchronizedList(new ArrayList<>());

    static Queue<ClientHandler> recoveryQueue =
            new LinkedList<>();

    static Queue<ClientHandler> waitingClients =
            new LinkedList<>();

    static Queue<ClientHandler> fittingRoomClients =
            new LinkedList<>();

    public static void main(String[] args) {

        new Thread(CentralServer::startClientServer).start();
        new Thread(CentralServer::startFittingRoomServer).start();
        new Thread(CentralServer::recoveryManager).start();
    }

    // ================= CLIENT SERVER =================

    static void startClientServer() {
        try (ServerSocket server = new ServerSocket(50000)) {

            while (true) {
                Socket s = server.accept();
                new Thread(new ClientHandler(s)).start();
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // ================= FITTING ROOM SERVER =================

    static void startFittingRoomServer() {
        try (ServerSocket server = new ServerSocket(50001)) {

            while (true) {
                Socket s = server.accept();
                FittingRoomHandler f = new FittingRoomHandler(s);
                fittingRooms.add(f);
                new Thread(f).start();
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // ================= RECOVERY MANAGER =================

    static void recoveryManager() {

        while (true) {

            ClientHandler c = null;

            synchronized (recoveryQueue) {
                c = recoveryQueue.poll();
            }

            if (c != null) {
                try {
                    c.requestNewRoom();
                } catch (Exception ignored) {}
            }

            try {
                Thread.sleep(100);
            } catch (Exception ignored) {}
        }
    }

    // ================= CLIENT HANDLER =================

    public static class ClientHandler implements Runnable {

        Socket client;
        BufferedReader in;
        PrintWriter out;

        int clientID = -1;

        FittingRoomHandler assignedRoom;

        volatile boolean active = true;

        // 🔥 CRASH-PROOF FIX (NO STATE MACHINE)
        private volatile boolean recoveryInProgress = false;

        public ClientHandler(Socket s) {
            try {
                client = s;
                in = new BufferedReader(
                        new InputStreamReader(s.getInputStream()));
                out = new PrintWriter(s.getOutputStream(), true);
            } catch (Exception e) {
                e.printStackTrace();
            }
        }

        // ================= ASSIGN ROOM =================

        public synchronized void assignRoom(FittingRoomHandler room) {

            if (!active) return;

            assignedRoom = room;

            waitingClients.remove(this);
            fittingRoomClients.remove(this);

            fittingRoomClients.add(this);

            out.println(
                    "Room Allocated " + clientID + ":" +
                            room.getFittingRoomIP());
        }

        // ================= REQUEST NEW ROOM =================

        public void requestNewRoom() {

            if (!active) return;

            // 🔥 FIX #1: prevent duplicate recovery
            if (recoveryInProgress) return;
            recoveryInProgress = true;

            boolean success = false;

            synchronized (fittingRooms) {

                for (FittingRoomHandler room : fittingRooms) {

                    if (!room.active) continue;

                    try {

                        String response =
                                room.sendRequest(
                                        "ALLOCATE " + clientID);

                        if (response == null) continue;

                        if (response.startsWith("Allocated")) {

                            assignRoom(room);
                            success = true;
                            return;
                        }

                        if (response.startsWith("Wait")) {
                            out.println("Wait :" + room.getFittingRoomIP());
                            success = true;
                            return;
                        }

                    } catch (Exception ignored) {}
                }
            }

            if (!success) {
                out.println("Full");
            }

            recoveryInProgress = false;
        }

        // ================= RUN =================

        @Override
        public void run() {

            try {

                String msg;

                while ((msg = in.readLine()) != null) {

                    if (msg.startsWith("Request Room")) {

                        clientID =
                                Integer.parseInt(msg.split(" ")[2]);

                        clientIDs.put(clientID, this);

                        recoveryQueue.add(this);
                    }

                    else if (msg.startsWith("Release Room")) {

                        if (assignedRoom != null) {

                            try {

                                String res =
                                        assignedRoom.sendRequest(
                                                "RELEASE " + clientID);

                                if (res != null &&
                                        res.startsWith("Promoted")) {

                                    int next =
                                            Integer.parseInt(
                                                    res.split(" ")[1]);

                                    ClientHandler c =
                                            clientIDs.get(next);

                                    if (c != null) {
                                        c.assignRoom(assignedRoom);
                                    }
                                }

                            } catch (Exception ignored) {}

                            assignedRoom = null;
                        }
                    }

                    else if (msg.equalsIgnoreCase("Exit")) {
                        disconnect();
                        return;
                    }
                }

            } catch (Exception ignored) {
            } finally {
                disconnect();
            }
        }

        public void disconnect() {

            active = false;

            try {
                clientIDs.remove(clientID);

                if (client != null)
                    client.close();

            } catch (Exception ignored) {}
        }
    }

    // ================= FITTING ROOM HANDLER =================

    public static class FittingRoomHandler implements Runnable {

        Socket socket;
        BufferedReader in;
        PrintWriter out;

        volatile boolean active = true;

        List<ClientHandler> assignedClients =
                Collections.synchronizedList(new ArrayList<>());

        public FittingRoomHandler(Socket s) {

            try {
                socket = s;
                in = new BufferedReader(
                        new InputStreamReader(s.getInputStream()));
                out = new PrintWriter(s.getOutputStream(), true);
            } catch (Exception e) {
                e.printStackTrace();
            }
        }

        public String getFittingRoomIP() {
            return socket.getInetAddress().getHostAddress();
        }

        @Override
        public void run() {

            try {
                while (in.readLine() != null) {
                    // idle
                }
            } catch (Exception e) {
                handleCrash();
            }
        }

        // ================= CRASH HANDLING =================

        public void handleCrash() {

            if (!active) return;
            active = false;

            synchronized (fittingRooms) {
                fittingRooms.remove(this);
            }

            for (ClientHandler c : assignedClients) {

                c.assignedRoom = null;

                CentralServer.recoveryQueue.add(c);

                if (c.out != null) {
                    c.out.println("Fitting Room Server Down");
                }
            }

            assignedClients.clear();
        }

        // ================= SEND REQUEST =================

        public synchronized String sendRequest(String msg)
                throws IOException {

            out.println(msg);

            String res = in.readLine();

            // 🔥 FIX #2: crash safety
            if (res == null) {
                handleCrash();
                throw new IOException("Room crashed");
            }

            return res;
        }
    }
}
