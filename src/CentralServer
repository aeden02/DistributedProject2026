import java.io.*;
import java.net.*;
import java.util.*;

public class CentralServer {

    static Map<Integer, ClientHandler> clientIDs =
            Collections.synchronizedMap(new HashMap<>());

    static List<FittingRoomHandler> fittingRooms =
            Collections.synchronizedList(new ArrayList<>());

    static Queue<ClientHandler> recoveryQueue =
            new LinkedList<>();

    static Queue<ClientHandler> waitingClients =
            new LinkedList<>();

    static Queue<ClientHandler> fittingRoomClients =
            new LinkedList<>();

    // ========================= MAIN =========================

    public static void main(String[] args) {

        new Thread(() -> startClientServer()).start();
        new Thread(() -> startFittingRoomServer()).start();
        new Thread(() -> recoveryManager()).start();
    }

    // ========================= CLIENT SERVER =========================

    public static void startClientServer() {

        try (ServerSocket server = new ServerSocket(50000)) {

            while (true) {
                Socket s = server.accept();
                ClientHandler c = new ClientHandler(s);
                new Thread(c).start();
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // ========================= FITTING ROOM SERVER =========================

    public static void startFittingRoomServer() {

        try (ServerSocket server = new ServerSocket(50001)) {

            while (true) {

                Socket s = server.accept();

                FittingRoomHandler f =
                        new FittingRoomHandler(s);

                fittingRooms.add(f);
                new Thread(f).start();
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // ========================= RECOVERY THREAD =========================

    public static void recoveryManager() {

        while (true) {

            ClientHandler c = null;

            synchronized (recoveryQueue) {
                if (!recoveryQueue.isEmpty()) {
                    c = recoveryQueue.poll();
                }
            }

            if (c != null) {
                try {
                    c.requestNewRoom();
                } catch (Exception ignored) {}
            }

            try {
                Thread.sleep(100);
            } catch (Exception ignored) {}
        }
    }

    // ========================= CLIENT HANDLER =========================

    public static class ClientHandler implements Runnable {

        Socket client;
        BufferedReader in;
        PrintWriter out;

        int clientID = -1;

        FittingRoomHandler assignedRoom;

        volatile boolean active = true;

        public ClientHandler(Socket s) {
            this.client = s;

            try {
                in = new BufferedReader(
                        new InputStreamReader(s.getInputStream()));

                out = new PrintWriter(
                        s.getOutputStream(), true);

            } catch (Exception e) {
                e.printStackTrace();
            }
        }

        // ========================= ROOM ASSIGN =========================

        public synchronized void assignRoom(FittingRoomHandler room) {

            if (!active) return;

            assignedRoom = room;

            out.println(
                    "Room Allocated "
                            + clientID
                            + ":"
                            + room.getFittingRoomIP());

            fittingRoomClients.remove(this);
            waitingClients.remove(this);

            if (!fittingRoomClients.contains(this)) {
                fittingRoomClients.add(this);
            }
        }

        // ========================= REQUEST NEW ROOM =========================

        public synchronized void requestNewRoom() {

            if (!active) return;

            synchronized (fittingRooms) {

                for (FittingRoomHandler room : fittingRooms) {

                    if (!room.active) continue;

                    try {

                        String response =
                                room.sendRequest(
                                        "ALLOCATE " + clientID);

                        if (response == null) continue;

                        if (response.startsWith("Allocated")) {

                            assignRoom(room);
                            return;
                        }

                        if (response.startsWith("Wait")) {

                            out.println(
                                    "Wait :" +
                                            room.getFittingRoomIP());

                            return;
                        }

                    } catch (Exception ignored) {}
                }
            }

            out.println("Full");
        }

        // ========================= RUN =========================

        @Override
        public void run() {

            try {

                String msg;

                while ((msg = in.readLine()) != null) {

                    if (msg.startsWith("Request Room")) {

                        String[] p = msg.split(" ");
                        clientID = Integer.parseInt(p[2]);

                        clientIDs.put(clientID, this);

                        requestNewRoom();
                    }

                    else if (msg.startsWith("Release Room")) {

                        if (assignedRoom != null) {

                            try {

                                String res =
                                        assignedRoom.sendRequest(
                                                "RELEASE " + clientID);

                                if (res != null &&
                                        res.startsWith("Promoted")) {

                                    int next =
                                            Integer.parseInt(
                                                    res.split(" ")[1]);

                                    ClientHandler c =
                                            clientIDs.get(next);

                                    if (c != null) {
                                        c.assignRoom(assignedRoom);
                                    }
                                }

                            } catch (Exception ignored) {}

                            assignedRoom = null;
                        }
                    }

                    else if (msg.equalsIgnoreCase("Exit")) {
                        disconnect();
                        return;
                    }
                }

            } catch (Exception ignored) {
            } finally {
                disconnect();
            }
        }

        // ========================= DISCONNECT =========================

        public synchronized void disconnect() {

            active = false;

            try {
                clientIDs.remove(clientID);

                if (client != null)
                    client.close();

            } catch (Exception ignored) {}
        }
    }

    // ========================= FITTING ROOM HANDLER =========================

    public static class FittingRoomHandler implements Runnable {

        Socket socket;
        BufferedReader in;
        PrintWriter out;

        boolean active = true;

        List<ClientHandler> assignedClients =
                Collections.synchronizedList(new ArrayList<>());

        public FittingRoomHandler(Socket s) {

            socket = s;

            try {
                in = new BufferedReader(
                        new InputStreamReader(
                                s.getInputStream()));

                out = new PrintWriter(
                        s.getOutputStream(), true);

            } catch (Exception e) {
                e.printStackTrace();
            }
        }

        public String getFittingRoomIP() {
            return socket.getInetAddress().getHostAddress();
        }

        @Override
        public void run() {

            try {

                String msg;

                while ((msg = in.readLine()) != null) {

                    // no-op (kept simple)
                }

            } catch (Exception e) {

                handleCrash();
            }
        }

        // ========================= CRASH HANDLER =========================

        public synchronized void handleCrash() {

            if (!active) return;

            active = false;

            synchronized (fittingRooms) {
                fittingRooms.remove(this);
            }

            for (ClientHandler c : assignedClients) {

                c.assignedRoom = null;

                CentralServer.recoveryQueue.add(c);

                if (c.out != null) {
                    c.out.println(
                            "Fitting Room Server Down");
                }
            }

            assignedClients.clear();
        }

        // ========================= SEND REQUEST =========================

        public synchronized String sendRequest(String msg)
                throws IOException {

            out.println(msg);

            String res = in.readLine();

            if (res == null) {
                handleCrash();
                throw new IOException("Room crashed");
            }

            return res;
        }
    }
}
