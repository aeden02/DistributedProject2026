import java.io.*;
import java.net.*;
import java.util.*;

public class CentralServer {

    static Map<Integer, ClientHandler> clientIDs =
            Collections.synchronizedMap(new HashMap<>());

    static ArrayList<FittingRoomHandler> fittingRooms =
            new ArrayList<>();

    static Queue<ClientHandler> recoveryQueue =
            new LinkedList<>();

    public static void main(String[] args) {

        System.out.println("CentralServer starting...");

        new Thread(() -> startClientSockets()).start();
        new Thread(() -> startFittingServers()).start();
        new Thread(() -> recoveryManager()).start();
    }

    // ================= CLIENT SERVER =================

    private static void startClientSockets() {

        try (ServerSocket server = new ServerSocket(50000)) {

            System.out.println("CentralServer running on port 50000...(waiting for Client)");

            while (true) {

                Socket clientSocket = server.accept();

                System.out.println("CENTRAL: About to accept client connection...");

                ClientHandler client = new ClientHandler(clientSocket);

                new Thread(client).start();
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // ================= FITTING ROOM SERVER =================

    public static void startFittingServers() {

        try (ServerSocket fitroomSocket = new ServerSocket(50001)) {

            System.out.println("CENTRAL: Listening for Fitting Rooms...");

            while (true) {

                Socket fittingRoom = fitroomSocket.accept();

                System.out.println("CENTRAL: Fitting Room Connected!");

                FittingRoomHandler f = new FittingRoomHandler(fittingRoom);

                fittingRooms.add(f);

                new Thread(f).start();

                System.out.println("Fitting rooms online: " + fittingRooms.size());
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // ================= RECOVERY =================

    static void recoveryManager() {

        while (true) {

            ClientHandler c = null;

            synchronized (recoveryQueue) {
                c = recoveryQueue.poll();
            }

            if (c != null) {
                c.requestNewRoom();
            }

            try {
                Thread.sleep(100);
            } catch (Exception ignored) {}
        }
    }

    // ================= CLIENT HANDLER =================

    public static class ClientHandler implements Runnable {

        Socket client;
        BufferedReader in;
        PrintWriter out;

        int clientID = -1;

        boolean hasRoom = false;
        boolean isWaiting = false;
        boolean active = true;

        FittingRoomHandler assignedRoom;

        private boolean recovering = false;

        public ClientHandler(Socket client) {

            this.client = client;

            try {
                in = new BufferedReader(
                        new InputStreamReader(client.getInputStream()));

                out = new PrintWriter(client.getOutputStream(), true);

            } catch (Exception e) {
                e.printStackTrace();
            }
        }

        // ================= ASSIGN ROOM =================

        public synchronized void assignRoom(FittingRoomHandler room) {

            assignedRoom = room;
            hasRoom = true;
            isWaiting = false;

            String ip = room != null ? room.getFittingRoomIP() : "UNKNOWN";

            out.println("Room Allocated " + clientID + ":" + ip);
        }

        // ================= REQUEST ROOM =================

        public void requestNewRoom() {

            if (recovering) return;
            recovering = true;

            String response = null;

            for (int i = 0; i < fittingRooms.size(); i++) {

                try {

                    FittingRoomHandler room = fittingRooms.get(i);

                    if (!room.active) continue;

                    response = room.sendRequest("ALLOCATE " + clientID);

                    if (response == null) continue;

                    System.out.println("CENTRAL GOT: " + response);

                    if (response.startsWith("Allocated")) {

                        assignRoom(room);
                        recovering = false;
                        return;
                    }

                    if (response.startsWith("Wait")) {

                        isWaiting = true;
                        hasRoom = false;

                        out.println("Wait :" + room.getFittingRoomIP());

                        recovering = false;
                        return;
                    }

                } catch (Exception e) {
                    System.out.println("Skipping dead fitting room...");
                }
            }

            out.println("Full " + clientID);
            recovering = false;
        }

        // ================= RUN =================

        @Override
        public void run() {

            try {

                String request;

                while ((request = in.readLine()) != null) {

                    System.out.println("Client says: " + request);

                    if (request.startsWith("Request Room")) {

                        clientID = Integer.parseInt(request.split(" ")[2]);

                        clientIDs.put(clientID, this);

                        recoveryQueue.add(this);
                    }

                    else if (request.startsWith("Release Room")) {

                        if (assignedRoom != null) {

                            String response =
                                    assignedRoom.sendRequest(
                                            "RELEASE " + clientID);

                            hasRoom = false;

                            System.out.println("CENTRAL GOT: " + response);

                            if (response.startsWith("Promoted")) {

                                int next =
                                        Integer.parseInt(response.split(" ")[1]);

                                ClientHandler c = clientIDs.get(next);

                                if (c != null) {
                                    c.assignRoom(assignedRoom);
                                }
                            }

                            out.println("Room released");
                        }
                    }

                    else if (request.equals("Exit")) {

                        active = false;
                        clientIDs.remove(clientID);
                        return;
                    }
                }

            } catch (Exception e) {
                System.out.println("CENTRAL ERROR: recovery triggered");
                recoveryQueue.add(this);
            }
        }
    }

    // ================= FITTING ROOM HANDLER =================

    public static class FittingRoomHandler implements Runnable {

        Socket socket;
        BufferedReader in;
        PrintWriter out;

        boolean active = true;

        public FittingRoomHandler(Socket s) {

            try {
                socket = s;

                in = new BufferedReader(
                        new InputStreamReader(s.getInputStream()));

                out = new PrintWriter(s.getOutputStream(), true);

            } catch (Exception e) {
                e.printStackTrace();
            }
        }

        public String getFittingRoomIP() {
            return socket.getInetAddress().getHostAddress();
        }

        @Override
        public void run() {

            try {
                String msg;

                while ((msg = in.readLine()) != null) {
                    System.out.println("FittingRoom: " + msg);
                }

            } catch (Exception e) {
                active = false;
                System.out.println("FITTING ROOM CRASHED");
            }
        }

        public synchronized String sendRequest(String msg)
                throws IOException {

            out.println(msg);

            String response = in.readLine();

            if (response == null) {
                active = false;
                throw new IOException("Fitting room crashed");
            }

            return response;
        }
    }
}
