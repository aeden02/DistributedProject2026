import java.io.*;
import java.net.*;
import java.util.*;

public class CentralServer {

    static Map<Integer, ClientHandler> clientIDs =
            Collections.synchronizedMap(new HashMap<>());

    static List<FittingRoomHandler> fittingRooms =
            Collections.synchronizedList(new ArrayList<>());

    static Queue<ClientHandler> recoveryQueue =
            new LinkedList<>();

    // ================= MAIN =================

    public static void main(String[] args) {

        System.out.println("CentralServer starting...");

        new Thread(CentralServer::startClientServer).start();
        new Thread(CentralServer::startFittingRoomServer).start();
        new Thread(CentralServer::recoveryManager).start();
    }

    // ================= CLIENT SERVER =================

    static void startClientServer() {
        try (ServerSocket server = new ServerSocket(50000)) {

            System.out.println("CentralServer running on port 50000...(waiting for Client)");

            while (true) {
                Socket s = server.accept();

                System.out.println("CENTRAL: About to accept client connection...");

                ClientHandler c = new ClientHandler(s);
                new Thread(c).start();
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // ================= FITTING ROOM SERVER =================

    static void startFittingRoomServer() {
        try (ServerSocket server = new ServerSocket(50001)) {

            System.out.println("CENTRAL: Listening for Fitting Rooms on port 50001...");

            while (true) {

                Socket s = server.accept();

                System.out.println("CENTRAL: Fitting Room Connected!");

                FittingRoomHandler f = new FittingRoomHandler(s);
                fittingRooms.add(f);

                new Thread(f).start();

                System.out.println("Fitting room ip: " +
                        s.getInetAddress().getHostAddress() +
                        " connected. Total: " + fittingRooms.size());
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // ================= RECOVERY MANAGER =================

    static void recoveryManager() {

        while (true) {

            ClientHandler c = null;

            synchronized (recoveryQueue) {
                c = recoveryQueue.poll();
            }

            if (c != null) {
                try {
                    c.requestNewRoom();
                } catch (Exception ignored) {}
            }

            try {
                Thread.sleep(100);
            } catch (Exception ignored) {}
        }
    }

    // ================= CLIENT HANDLER =================

    public static class ClientHandler implements Runnable {

        Socket client;
        BufferedReader in;
        PrintWriter out;

        int clientID = -1;
        boolean hasRoom = false;
        boolean isWaiting = false;
        boolean active = true;

        FittingRoomHandler assignedRoom;

        volatile boolean recoveryLock = false;

        public ClientHandler(Socket s) {
            try {
                client = s;

                in = new BufferedReader(
                        new InputStreamReader(s.getInputStream()));

                out = new PrintWriter(s.getOutputStream(), true);

            } catch (Exception e) {
                e.printStackTrace();
            }
        }

        // ================= ROOM ASSIGN =================

        public synchronized void assignRoom(FittingRoomHandler room) {

            if (!active) return;

            assignedRoom = room;
            hasRoom = true;
            isWaiting = false;

            System.out.println("Room Allocated " + clientID);

            out.println("Room Allocated " + clientID + ":" +
                    room.getFittingRoomIP());
        }

        // ================= REQUEST NEW ROOM =================

        public void requestNewRoom() {

            if (!active || recoveryLock) return;

            recoveryLock = true;

            System.out.println("FORWARDING REQUEST TO FITTING ROOM");

            String response = null;

            for (int i = 0; i < fittingRooms.size(); i++) {

                try {

                    FittingRoomHandler room = fittingRooms.get(i);

                    response = room.sendRequest("ALLOCATE " + clientID);

                    System.out.println("CENTRAL GOT FROM FITTING ROOM: " + response);

                    if (response == null) continue;

                    if (response.startsWith("Allocated")) {

                        assignRoom(room);
                        recoveryLock = false;
                        return;
                    }

                    if (response.startsWith("Wait")) {

                        isWaiting = true;
                        hasRoom = false;

                        out.println("Wait :" + room.getFittingRoomIP());

                        recoveryLock = false;
                        return;
                    }

                    if (response.startsWith("Full")) {
                        continue;
                    }

                } catch (Exception ignored) {}
            }

            out.println("Full " + clientID);

            recoveryLock = false;
        }

        // ================= RUN =================

        @Override
        public void run() {

            try {

                InputStream inStream = client.getInputStream();
                OutputStream outStream = client.getOutputStream();

                BufferedReader clientIn =
                        new BufferedReader(new InputStreamReader(inStream));

                out = new PrintWriter(outStream, true);

                String request;

                while ((request = clientIn.readLine()) != null) {

                    System.out.println("Client says: " + request);

                    if (request.startsWith("Request Room")) {

                        String[] parts = request.split(" ");

                        clientID = Integer.parseInt(parts[2]);

                        clientIDs.put(clientID, this);

                        requestNewRoom();
                    }

                    else if (request.startsWith("Release Room")) {

                        if (assignedRoom != null) {

                            System.out.println("Client hasRoom before release: " + hasRoom);

                            String response =
                                    assignedRoom.sendRequest(
                                            "RELEASE " + clientID);

                            hasRoom = false;

                            System.out.println("CENTRAL GOT FROM FITTING ROOM: " + response);

                            if (response != null &&
                                    response.startsWith("Promoted")) {

                                int next =
                                        Integer.parseInt(response.split(" ")[1]);

                                ClientHandler c = clientIDs.get(next);

                                if (c != null) {
                                    c.assignRoom(assignedRoom);
                                }
                            }

                            System.out.println("Client " + clientID + " released a room.");
                            out.println("Room released");
                        }
                    }

                    else if (request.equals("Exit")) {

                        System.out.println("Client requested exit");

                        active = false;
                        clientIDs.remove(clientID);
                        return;
                    }
                }

            } catch (Exception e) {

                System.out.println("CENTRAL ERROR: FITTING ROOM SERVER FAILED");
                System.out.println("Reassigning affected clients...");
            }
        }
    }

    // ================= FITTING ROOM HANDLER =================

    public static class FittingRoomHandler implements Runnable {

        Socket socket;
        BufferedReader in;
        PrintWriter out;

        boolean active = true;

        ArrayList<ClientHandler> assignedClients =
                new ArrayList<>();

        public FittingRoomHandler(Socket s) {

            try {
                socket = s;

                in = new BufferedReader(
                        new InputStreamReader(s.getInputStream()));

                out = new PrintWriter(s.getOutputStream(), true);

            } catch (Exception e) {
                e.printStackTrace();
            }
        }

        public String getFittingRoomIP() {
            return socket.getInetAddress().getHostAddress();
        }

        @Override
        public void run() {

            try {

                String msg;

                while ((msg = in.readLine()) != null) {
                    System.out.println("FittingRoom: " + msg);
                }

            } catch (Exception e) {
                handleCrash();
            }
        }

        public synchronized void handleCrash() {

            if (!active) return;

            active = false;

            System.out.println("FITTING ROOM SERVER DISCONNECTED");

            fittingRooms.remove(this);

            for (ClientHandler c : assignedClients) {
                recoveryQueue.add(c);
                c.out.println("Fitting Room Server Down");
            }

            assignedClients.clear();
        }

        public synchronized String sendRequest(String msg)
                throws IOException {

            out.println(msg);

            String response = in.readLine();

            if (response == null) {
                handleCrash();
                throw new IOException("Crash");
            }

            return response;
        }
    }
}
